{
  "name": "orbit",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "build": "pnpm --filter @orbit/web build && pnpm --filter @orbit/server build",
    "e2e": "sh -c 'command -v heavy-suite >/dev/null 2>&1 && exec heavy-suite pnpm run e2e:run || exec pnpm run e2e:run'",
    "e2e:run": "pnpm build && playwright test --config e2e/playwright.config.ts",
    "format:check": "prettier --check .",
    "secrets:check": "gitleaks detect --no-banner --redact",
    "gate": "sh -c 'command -v heavy-suite >/dev/null 2>&1 && exec heavy-suite pnpm run gate:run || exec pnpm run gate:run'",
    "gate:run": "pnpm -r --workspace-concurrency=1 run gate:pkg && pnpm format:check && pnpm secrets:check && pnpm e2e"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@syntopica/prettier-config": "^0.3.0",
    "lefthook": "^2.2.1",
    "prettier": "^3.9.10",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
